# OrganizUS - configuración de producción autohospedada
# Copia este archivo a /var/www/organizus/.env en el VPS y completa los valores.
# No subas nunca el archivo .env resultante a Git.

NODE_ENV=production
PORT=3000
APP_BASE_URL=https://organizus.es

# MySQL o MariaDB. Crea una base de datos y un usuario exclusivos para OrganizUS.
DATABASE_URL=mysql://organizus_user:CAMBIA_ESTA_CLAVE@127.0.0.1:3306/organizus

# Genera un valor aleatorio largo: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO

# Se crea automáticamente SOLO si no existe ningún usuario con este correo.
ADMIN_NAME=Administrador OrganizUS
ADMIN_EMAIL=admin@organizus.es
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_LARGA

# Directorio persistente de imágenes, PDFs y otros ficheros subidos.
UPLOAD_DIR=/var/www/organizus/data/uploads

# Ajusta esta variable solo si Chromium se instala en otra ruta.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
